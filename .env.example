# Copy this file to .env and fill in your own values. NEVER commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# DEBUG is False when missing. Use True only on your own computer.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set to True only when the site is served over HTTPS (secure cookies, HSTS).
HTTPS=False

# PostgreSQL / Supabase (Settings > Database > Connection info)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
